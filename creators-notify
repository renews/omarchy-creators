#!/usr/bin/env bash
# Desktop notification for one new video or one channel going live.
#
# notify-send blocks while actions are on screen and prints the chosen action
# key, so this script stays alive for the life of the notification and then acts
# on the click itself on other desktops. Omarchy uses a persistent command
# hint so clicks also work after the sender exits or the shell reloads.
#
#   creators-notify --title T --body B --url URL [--icon PATH]
#                 [--default browser|pip|none] [--timeout MS]
#                 [--pip-position P] [--pip-size S] [--urgency LEVEL]

set -uo pipefail

title="" body="" url="" icon="" default="browser" timeout="12000"
pip_position="" pip_size="" urgency="normal"
here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)

while (($# > 0)); do
  case "$1" in
    --title) title=$2; shift 2 ;;
    --body) body=$2; shift 2 ;;
    --url) url=$2; shift 2 ;;
    --icon) icon=$2; shift 2 ;;
    --default) default=$2; shift 2 ;;
    --timeout) timeout=$2; shift 2 ;;
    --pip-position) pip_position=$2; shift 2 ;;
    --pip-size) pip_size=$2; shift 2 ;;
    --urgency) urgency=$2; shift 2 ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
  esac
done

[[ -n $title ]] || { echo "--title is required" >&2; exit 2; }
[[ -z $url || $url =~ ^https?:// ]] || { echo "refusing a non-http url" >&2; exit 2; }

open_browser() { [[ -n $url ]] && omarchy-launch-browser "$url"; }

pip_args=("$here/creators-pip" open "$url" --title "$title")
[[ -n $pip_position ]] && pip_args+=(--position "$pip_position")
[[ -n $pip_size ]] && pip_args+=(--size "$pip_size")

open_pip() { [[ -n $url ]] && "${pip_args[@]}"; }

notify=(notify-send --app-name="Omarchy Creators" --urgency="$urgency" --expire-time="$timeout")
[[ -n $icon && -f $icon ]] && notify+=(--icon="$icon")

# Omarchy runs saved commands for the body and the buttons. Other notification
# servers return an action key to this process, which must stay running.
if [[ -n $url ]]; then
  if [[ $default != none ]]; then
    click_args=(omarchy-launch-browser "$url")
    [[ $default == pip ]] && click_args=("${pip_args[@]}")
    click_json=$(printf '%s\0' "${click_args[@]}" | jq -Rsc 'split("\u0000")[:-1]') || exit 1
    notify+=(--hint="string:omarchy-exec-argv:$click_json")
  fi
  if [[ $(omarchy-shell notifications ping 2>/dev/null) == ok ]]; then
    browser_json=$(printf '%s\0' omarchy-launch-browser "$url" | jq -Rsc 'split("\u0000")[:-1]') || exit 1
    pip_json=$(printf '%s\0' "${pip_args[@]}" | jq -Rsc 'split("\u0000")[:-1]') || exit 1
    actions_json=$(jq -cn --argjson browser "$browser_json" --argjson pip "$pip_json" \
      '[{label: "Open", argv: $browser}, {label: "PiP", argv: $pip}]') || exit 1
    notify+=(--hint="string:omarchy-actions:$actions_json")
  else
    [[ $default != none ]] && notify+=(--action="default=Open")
    notify+=(--action="browser=Open" --action="pip=PiP")
  fi
fi

chosen=$("${notify[@]}" -- "$title" "$body" 2>/dev/null)

case "$chosen" in
  browser) open_browser ;;
  pip) open_pip ;;
  default) [[ $default == pip ]] && open_pip || open_browser ;;
  *) : ;;  # dismissed or timed out
esac
